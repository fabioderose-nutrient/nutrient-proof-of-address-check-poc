# Data Extraction API key (required).
# Get an API key at https://dashboard.nutrient.io/sign_in/. At the time of writing, the free plan includes 5,000 credits per month to test the Data Extraction API.
NUTRIENT_API_KEY=

# Web SDK license key for the document viewer. Empty = evaluation mode.
WEB_SDK_LICENSE_KEY=

# Default parse mode: structure, understand or agentic
EXTRACTION_MODE=structure

# Optional folder that keeps API responses during development. Empty = no cache.
EXTRACTION_CACHE_DIR=

PORT=4740
